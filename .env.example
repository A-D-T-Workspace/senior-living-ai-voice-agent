# Application
APP_NAME=SeniorLiving AI
APP_ENV=development
DEBUG=true

# Local LLM
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# Voice
WHISPER_MODEL=base
